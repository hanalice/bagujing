# ==============================================================================
# Bagujing 前端环境变量配置模板 (Frontend Environment Configuration)
# 
# 使用说明:
# 1. 本地开发: cp .env.example .env.local
# 2. 生产构建: cp .env.example .env.production
# 3. 标记为 [必填] 的项必须按实际环境配置；标记为 [选填] 的项若未配置则自动使用默认值。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API 接口与 AI 鉴权配置
# ------------------------------------------------------------------------------
# [选填 | 默认: /api] 后端 API 请求基地址 (本地开发由 Vite 自动代理至后端 3000 端口)
VITE_API_BASE_URL=/api

# [选填 | 默认: web] AI 网关签名客户端 ID (需与 backend 的 AI_CLIENT_CREDENTIALS 保持一致)
VITE_AI_CLIENT_ID=web

# [必填(若开启AI网关) | 无默认值] AI 网关签名客户端密钥 (需与 backend 的 AI_CLIENT_CREDENTIALS 保持一致)
VITE_AI_CLIENT_SECRET=change_me

# ------------------------------------------------------------------------------
# 2. Sentry 监控与全链路追踪 (可选，需与 VITE_SENTRY_DSN 配套生效)
# ------------------------------------------------------------------------------
# [选填 | 默认: 空/禁用] Sentry 错误与性能监控 DSN 地址 (留空表示不开启监控上报)
VITE_SENTRY_DSN=

# [选填 | 默认: 0.2] Sentry 性能链路追踪采样率 (范围: 0.0 ~ 1.0，0.2 表示采样 20% 的请求与会话)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# [选填 | 默认: 1500] 慢 API 告警阈值 (毫秒，超过此耗时自动记录警告事件)
VITE_MONITOR_API_SLOW_MS=1500

# [选填 | 默认: 当前模式/日期] 前端发版版本号 (用于 Sentry 上报时标记发布版本)
VITE_RELEASE=2026.03.10

# [选填 | 默认: localhost,/api] Sentry 分布式全链路追踪白名单 (需配合 VITE_SENTRY_DSN 使用)
# 作用: 仅允许匹配该白名单的 API 请求自动注入 sentry-trace 追踪头，将前端点击与后端调用耗时串联为完整 Trace
# 配置: 填入后端 API 的相对路径或域名，多个以逗号分隔 (如 localhost,/api,https://api.yourdomain.com)
VITE_TRACE_PROPAGATION_TARGETS=localhost,/api,https://your-server-domain/api
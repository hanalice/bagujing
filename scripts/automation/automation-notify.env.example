# 复制到本机（任选其一，勿提交）：
#   ~/.config/bagujing/automation-notify.env
#   或本目录 automation-notify.env.local
#
# 网易 163：邮箱设置 → POP3/SMTP/IMAP → 开启 SMTP，生成「授权码」
# （登录密码不能直接当 SMTP_PASS）

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_STARTTLS=0
SMTP_USER=<EMAIL_ADDRESS>
SMTP_PASS=<SMTP_PASS>
MAIL_FROM=<EMAIL_ADDRESS>
MAIL_TO=<EMAIL_ADDRESS>
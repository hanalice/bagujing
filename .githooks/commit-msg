#!/usr/bin/env bash
# ==============================================================================
# Git Commit-msg Hook:
# 1. 自动清理 Cursor / IDE 注入的水印标记
# 2. 委托 scripts/check-commit-msg.sh 校验 Conventional Commits 与结构化正文
# ==============================================================================

set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

# 1. 清理 Cursor / IDE 自动注入的水印行
sed -i -E \
  -e '/^[[:space:]]*Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>[[:space:]]*$/d' \
  -e '/^[[:space:]]*Made-with:[[:space:]]*Cursor[[:space:]]*$/d' \
  -e '/^[[:space:]]*Made with Cursor[[:space:]]*$/d' \
  "$msg_file"

# 2. 允许通过环境变量临时跳过校验
if [ "${COMMIT_MSG_GATE:-on}" = "off" ]; then
  exit 0
fi

# 3. 调用共享校验脚本（E11：与日修沙盒同一入口）
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
exec bash "$REPO_ROOT/scripts/check-commit-msg.sh" "$msg_file"

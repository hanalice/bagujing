# ==============================================================================
# DevAsk (职问AI) 后端环境变量配置模板 (Backend Environment Configuration)
# 
# 使用说明:
# 1. 本地开发: cp .env.example .env
# 2. 生产环境: cp .env.example .env.production
# 3. 标记为 [必填] 的项必须按实际环境配置；标记为 [选填] 的项若未配置则自动使用代码内置默认值。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置 (Server Settings)
# ------------------------------------------------------------------------------
# HTTP 服务监听端口 (默认: 3000)
PORT=3000

# [选填 | 默认: bagujing-secret-2026] 用户身份认证 JWT 密钥 (生产环境强烈建议修改为强随机字符串)
JWT_SECRET=bagujing-secret-2026

# ------------------------------------------------------------------------------
# 2. 数据库与持久化配置 (Database & Persistence)
# ------------------------------------------------------------------------------
# [选填 | 默认: true] 是否启用 SQLite 本地数据库
ENABLE_SQLITE=true

# [选填 | 默认: ./db/bagujing.dev.sqlite3] SQLite 数据库文件路径 (相对 backend 目录)
SQLITE_DB=./db/bagujing.dev.sqlite3

# [选填 | 默认: 空/内存存储] Redis 连接地址 (用于分布式限流与缓存，留空则使用内存存储)
# 示例: redis://localhost:6379 或 redis://:password@127.0.0.1:6379/0
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. 大模型 / LLM 上游配置 (OpenAI-Compatible API)
# ------------------------------------------------------------------------------
# [必填 | 无默认值] 大模型服务商 API Key (如 DeepSeek 或 OpenAI 密钥)
OPENAI_API_KEY=

# [选填 | 默认: https://api.openai.com/v1] 大模型接口 Base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# [选填 | 默认: gpt-4o-mini] 使用的模型标识 (例如: deepseek-chat 或 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. AI 防护网关与鉴权签名 (AI Guard & Security)
# ------------------------------------------------------------------------------
# [选填 | 默认: true] 是否启用 AI 防护网关
AI_GUARD_ENABLED=true

# [选填 | 默认: false] 是否强制校验 HMAC 签名请求头 (生产开启防盗刷时建议设为 true)
AI_REQUIRE_SIGNED_HEADERS=true

# [选填 | 默认: web] 默认客户端标识
AI_DEFAULT_CLIENT_ID=web

# [选填 | 默认: http://127.0.0.1,http://localhost] 允许访问 AI 接口的前端 Origin 白名单 (逗号分隔，支持通配端口 :*)
AI_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# [必填(若开启签名) | 默认: web:change_me] 客户端签名凭证列表 (格式: clientId:clientSecret，需与前端保持一致)
AI_CLIENT_CREDENTIALS=web:change_me

# [选填 | 默认: change_me_jwt_secret] AI 防护网关内部 JWT 签名密钥
AI_JWT_SECRET=change_me_jwt_secret

# ------------------------------------------------------------------------------
# 5. 请求尺寸、超时与防重放 (Limits, Timeouts & Replay Prevention)
# ------------------------------------------------------------------------------
# [选填 | 默认: 1200] 单次输入最大字符数限制 (防止超大 Prompt 消耗 Token)
AI_MAX_INPUT_CHARS=1200

# [选填 | 默认: 800] 模型单次回复最大 Token 数限制
AI_MAX_COMPLETION_TOKENS=800

# [选填 | 默认: 30000] 上游大模型 API 响应超时时间 (毫秒，30000 = 30秒)
AI_UPSTREAM_TIMEOUT_MS=30000

# [选填 | 默认: 20000] SSE 流式输出空闲超时时间 (毫秒，20000 = 20秒内无新 chunk 则中断)
AI_SSE_IDLE_TIMEOUT_MS=20000

# [选填 | 默认: 300000] 客户端请求签名允许的最大时钟偏差 (毫秒，300000 = 5分钟)
AI_MAX_CLOCK_SKEW_MS=300000

# [选填 | 默认: 600000] 请求 Nonce 防重放缓存有效期 (毫秒，600000 = 10分钟)
AI_NONCE_TTL_MS=600000

# ------------------------------------------------------------------------------
# 6. 多维速率限制与配额 (Rate Limits & Quotas)
# ------------------------------------------------------------------------------
# [选填 | 默认: 10] 单客户端每分钟最大请求次数
AI_RATE_LIMIT_CLIENT_PER_MINUTE=10

# [选填 | 默认: 100] 单客户端每小时最大请求次数
AI_RATE_LIMIT_CLIENT_PER_HOUR=100

# [选填 | 默认: 30] 单 IP 每分钟最大请求次数
AI_RATE_LIMIT_IP_PER_MINUTE=30

# [选填 | 默认: 2] 单客户端最大同时并发请求数
AI_MAX_CONCURRENCY_PER_CLIENT=2

# [选填 | 默认: 200] 单客户端每日请求总次数上限
AI_DAILY_REQUEST_LIMIT_PER_CLIENT=200

# [选填 | 默认: 50000] 单客户端每日消耗 Token 总数上限
AI_DAILY_TOKEN_LIMIT_PER_CLIENT=50000

# [选填 | 默认: 5000] 全局每日请求总次数上限 (兜底熔断)
AI_GLOBAL_DAILY_REQUEST_LIMIT=5000

# [选填 | 默认: 500000] 全局每日消耗 Token 总数上限 (兜底熔断)
AI_GLOBAL_DAILY_TOKEN_LIMIT=500000

# ------------------------------------------------------------------------------
# 7. 审计日志配置 (Audit Logging)
# ------------------------------------------------------------------------------
# [选填 | 默认: data/ai-audit.ndjson] AI 调用决策与放行审计文件保存路径 (相对 backend 目录)
AI_AUDIT_FILE_PATH=data/ai-audit.ndjson

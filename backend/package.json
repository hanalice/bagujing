{
  "name": "bagujing-be",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/server-express.js",
  "scripts": {
    "start": "node src/server-express.js",
    "lint": "eslint --ext .js src",
    "test": "node --test \"src/tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-exclude=src/tests/** \"src/tests/**/*.test.js\"",
    "import-data": "node scripts/import-ndjson-to-sqlite.js",
    "import-data:categories": "node scripts/import-ndjson-to-sqlite.js --only categories",
    "import-data:problems": "node scripts/import-ndjson-to-sqlite.js --only problems",
    "import-data:details": "node scripts/import-ndjson-to-sqlite.js --only details",
    "postinstall": "npm run import-data"
  },
  "dependencies": {
    "@langchain/core": "^1.1.40",
    "@langchain/openai": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11"
  }
}